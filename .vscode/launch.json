{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Debug bff-service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/bff-service",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Debug login-service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8100"
            ],
            "cwd": "${workspaceFolder}/login-service",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Debug user-service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8200"
            ],
            "cwd": "${workspaceFolder}/user-service",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local"
        },
        {
            "name": "Debug post-service",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8300"
            ],
            "cwd": "${workspaceFolder}/post-service",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env.local"
        },
    ]
}